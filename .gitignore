/target
# Build output for other targets and containers: `CARGO_TARGET_DIR=target-linux`
# and the like. `/target` alone once let 13G of container build output be
# staged into a commit.
/target-*

# Icon assets under assets/icon/ are generated by scripts/make_icon.py but are
# deliberately committed, all 260K of them. build.rs embeds the .ico, the binary
# includes the .png, and the packaging scripts copy the .iconset and hicolor
# trees — so ignoring them would make Python and Pillow a build dependency for
# everyone. Regenerate with `python3 scripts/make_icon.py assets/icon` after
# changing the drawing.

# Snapshot test artifacts
/tests/snapshots/*.diff.png
/tests/snapshots/*.new.png
/tests/snapshots/*.old.png

# Packaging output, when CARGO_TARGET_DIR points somewhere else
/gitup-*.tar.gz
/gitup-*.zip
/*.dmg

.DS_Store
